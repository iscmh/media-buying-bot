# =============================================================================
# Media Buying Bot — Environment Variables
# =============================================================================
# Copy to .env (root, for shared/db tooling), apps/web/.env.local, and
# apps/bot/.env. NEVER commit real values. See README "Manual setup" section.
# =============================================================================

# ----- Runtime -----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase -----
# Create project at https://supabase.com/dashboard, then grab values from
# Settings → API and Settings → Database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Direct Postgres connection string for Drizzle (use the "Session" pooler
# string from Supabase → Settings → Database → Connection string).
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Vault key id used for column encryption (created via SQL migration).
SUPABASE_VAULT_KEY_ID=mbb_master_key_v1

# ----- Auth (Google OAuth) -----
# Configured inside Supabase Auth dashboard. Listed here for reference only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ----- Sentry -----
NEXT_PUBLIC_SENTRY_DSN=https://YOUR-DSN@sentry.io/PROJECT
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=media-buying-bot

# ----- Inngest -----
# https://app.inngest.com → Settings → Keys
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-your-signing-key

# ----- Resend (transactional email) -----
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ----- Telegram bot -----
# Create via @BotFather. Use /setdomain to bind to your web app domain for
# auto-login (later phase).
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotName_bot
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# ----- Anti-ban / spend safety knobs -----
# Master kill switch. Set true to make the bot run all logic but produce ZERO
# Meta API mutations. Critical for testing changes safely.
BOT_DRY_RUN=true

# Hard ceiling per user per day (USD). Platform enforces this even if user
# sets a higher cap in their settings.
PLATFORM_DAILY_SPEND_CEILING_USD=500

# Internal cap as % of Meta's 200/hr Standard Access budget.
META_RATE_LIMIT_INTERNAL_CAP_PCT=60

# Meta Graph API version. Update quarterly when Meta deprecates older versions.
META_API_VERSION=v21.0

# ----- Observability / ops -----
# Set true to enable verbose logs from the rate-limit scheduler and audit log.
DEBUG_LOGS=false

# ----- Phase 8 Whop billing (optional in dev; required in prod) -----
# API key from the Whop dashboard, used to mint payment links.
WHOP_API_KEY=
# Secret from the Whop webhook config — HMAC-SHA256 verification.
WHOP_WEBHOOK_SECRET=
# Product IDs from the Whop catalog. Each tier is its own product.
WHOP_PRODUCT_ID_MONTHLY=
WHOP_PRODUCT_ID_ANNUAL=
WHOP_PRODUCT_ID_LIFETIME=
# Add-on product for the per-ad-account agency slot ($49/mo).
WHOP_ADDON_PRODUCT_ID_AD_ACCOUNT=

# ----- Phase 3f/3g HeyGen Avatar Mode -----
# Platform fallback avatar id. Used when (a) the user has not set a
# forced override in /settings, AND (b) Claude-based smart matching
# failed (e.g. empty catalog, ranking timeout). Find one at
# https://app.heygen.com/avatars (copy the avatar_id from the API).
HEYGEN_DEFAULT_AVATAR_ID=

# ----- Betting bot (@mbb/betting-bot) -----
# Free key from https://the-odds-api.com (500 requests/month).
ODDS_API_KEY=your-odds-api-key
# Needed only for the --ai risk-review layer.
ANTHROPIC_API_KEY=your-anthropic-api-key
