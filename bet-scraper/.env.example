# Copy this file to ".env" and fill in your keys.

# The Odds API — https://the-odds-api.com  (free tier ~500 req/month)
# Required. Powers the market odds / de-vigged consensus probabilities.
ODDS_API_KEY=

# API-Football — https://www.api-football.com  (free tier ~100 req/day)
# Optional. Adds model win/draw/away % + advice for SOCCER matches.
# This is the direct api-sports.io key (header auth), NOT a RapidAPI key.
API_FOOTBALL_KEY=
