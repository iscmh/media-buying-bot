{
  "baseUrl": "https://www.todaymatchprediction.com",
  "_comment": "Selectors are best-effort defaults. If scraping returns nothing, run with --debug, open debug/*.html, and adjust the selectors below. Leave a selector as an empty string to fall back to built-in heuristics.",
  "knownSports": [
    "football",
    "soccer",
    "basketball",
    "tennis",
    "baseball",
    "hockey",
    "ice hockey",
    "cricket",
    "rugby",
    "handball",
    "volleyball",
    "esports",
    "american football",
    "nfl",
    "nba",
    "mlb",
    "nhl"
  ],
  "selectors": {
    "navLinks": "header a, nav a, .menu a, #menu a",
    "matchLinks": "a[href*='prediction'], a[href*='vs'], .match a, .fixture a, .game a",
    "matchContainer": ".match, .fixture, .game, article, .prediction",
    "teams": ".team, .team-name, .home, .away, h1, h2",
    "league": ".league, .competition, .tournament",
    "kickoff": "time, .time, .date, .kickoff",
    "predictionBlocks": ".prediction, .tip, .bet, table, .odds, .stats"
  }
}
