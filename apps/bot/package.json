    "grammy": "^1.32.0",
    "inngest": "^3.27.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
