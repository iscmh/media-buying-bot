# =============================================================================
# Reina del Mar deal tracker
# =============================================================================
# Standalone: it shares no database, auth or Meta credentials with the rest of
# this repo. Copy to apps/deal-tracker/.env and edit.
# =============================================================================

# ----- Telegram -----
# 1. Message @BotFather -> /newbot -> copy the token here.
# 2. Start a chat with your new bot, send it /start, then run the tracker —
#    it replies with your chat id. Paste that below and restart.
# Leave both blank to run in console-only mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Where prices come from -----
# mock    = offline demo data, no network calls (start here)
# browser = drive the real booking widget in headless Chromium
# api     = replay the engine's own JSON request (fastest; needs `pnpm discover`)
TRACKER_SOURCE=mock
TRACKER_BOOKING_URL=https://reservations.hvdhotels.com/hvd-reina-del-mar/
# Deep-link template, if the engine accepts search params in the URL.
# Placeholders: {checkIn} {checkOut} {nights} {adults} {children} {childAges} {currency}
# TRACKER_URL_TEMPLATE=https://reservations.hvdhotels.com/hvd-reina-del-mar/?lng=en-GB&currency={currency}&checkin={checkIn}&checkout={checkOut}&adults={adults}&children={children}&childrenAges={childAges}
TRACKER_ENDPOINT_FILE=./data/endpoint.json

# ----- Who is travelling -----
TRACKER_ADULTS=3
TRACKER_CHILD_AGES=12
TRACKER_CURRENCY=EUR

# ----- What to search -----
# Check-in dates to sweep (both ends inclusive); stays may finish after the end date.
TRACKER_SEASON_START=2027-06-01
TRACKER_SEASON_END=2027-09-15
TRACKER_NIGHTS=7,10,14
TRACKER_CHECKIN_STEP_DAYS=1
# Only these weekday check-ins (0=Sun..6=Sat). Blank = every day.
# TRACKER_CHECKIN_WEEKDAYS=5,6

# ----- How hard to poll -----
# Each tick prices QUERIES_PER_TICK combinations and moves a rolling cursor,
# so the full season is re-priced every (matrix size / QUERIES_PER_TICK) ticks.
TRACKER_POLL_MINUTES=5
TRACKER_QUERIES_PER_TICK=24
TRACKER_CONCURRENCY=2
TRACKER_REQUEST_DELAY_MS=1200

# ----- When to shout -----
TRACKER_DROP_PCT=4
# TRACKER_TARGET_TOTAL=3200
# TRACKER_TARGET_PPPN=55
TRACKER_ALERT_COOLDOWN_HOURS=6
# Sanity band — anything outside it is treated as a scraping mistake, not a deal.
TRACKER_MIN_PLAUSIBLE_TOTAL=150
TRACKER_MAX_PLAUSIBLE_TOTAL=30000
# No routine alerts between these hours (local time). Target hits always get through.
TRACKER_QUIET_HOURS=23-8

# ----- Files -----
TRACKER_STATE_FILE=./data/state.json
TRACKER_LOG_FILE=./data/quotes.ndjson
# Set to false to watch the browser work (useful while configuring selectors).
TRACKER_HEADLESS=true
