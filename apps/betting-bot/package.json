{
  "name": "@mbb/betting-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Market-based sports betting value scanner: de-vigs multi-book odds, finds +EV outliers vs sharp consensus, sizes stakes with fractional Kelly, and runs a Claude risk review.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli.ts scan",
    "sports": "tsx src/cli.ts sports"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
